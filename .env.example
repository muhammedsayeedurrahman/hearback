# Rime (server-side only, never in client code)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=coda
RIME_SPEAKER_EN=lyra
RIME_SPEAKER_HI=nadi
RIME_LANG=en
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLE_RATE=16000
RIME_WS_URL=wss://users-ws.rime.ai/ws3
RIME_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# STT and LLM
DEEPGRAM_API_KEY=your_deepgram_key
ANTHROPIC_API_KEY=your_anthropic_key

# Stress fixture
TOOL_DELAY_MS=3000
